  <!-- Heuristic: only custom fields (__c) are counted, because standard field names cannot be told apart. -->
  <rule
    name="R1ValidationRuleErrorLocation"
    language="xml"
    class="net.sourceforge.pmd.lang.rule.xpath.XPathRule"
    message="The rule checks a single field: show the error on that field (errorDisplayField)."
  >
    <description>Conventions: VI. Validation Rules, Rule 3.</description>
    <priority>3</priority>
    <properties>
      <property name="xpath">
        <value
        ><![CDATA[
//ValidationRule[not(errorDisplayField)][
  count(distinct-values(
    analyze-string(string-join(errorConditionFormula/text/@Text, ''), '[A-Za-z][A-Za-z0-9_]*__c')//*:match ! string(.)
  )) = 1
